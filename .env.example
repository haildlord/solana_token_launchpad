# Copy this file to .env and fill in your own values.

# Password of your local PostgreSQL "postgres" user
DB_PASSWORD=your_password_here

# Any long random text. It is used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: one full connection string. If set, it is used instead of DB_PASSWORD.
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/token_launchpad
