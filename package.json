{
  "name": "lordlaunch",
  "version": "1.0.0",
  "description": "LordLaunch token launchpad - Hono API on Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "dev": "npm run build && wrangler dev",
    "start": "npm run dev",
    "deploy": "npm run build && wrangler deploy --minify",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.js\""
  },
  "license": "ISC",
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  }
}
